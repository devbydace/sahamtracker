{
  "name": "tracking-saham",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "bot": "npx tsx scripts/telegram-bot.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:status": "npx tsx scripts/db-manager.ts status",
    "db:init": "npx tsx scripts/db-manager.ts init",
    "db:backup": "npx tsx scripts/db-manager.ts backup",
    "db:restore": "npx tsx scripts/db-manager.ts restore",
    "db:reset": "npx tsx scripts/db-manager.ts reset",
    "db:push": "prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "webhook:set": "npx tsx scripts/set-telegram-webhook.ts set",
    "webhook:info": "npx tsx scripts/set-telegram-webhook.ts info",
    "webhook:clear": "npx tsx scripts/set-telegram-webhook.ts clear"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
